{
  "name": "unlocode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "data:download": "node --import tsx ./src/data/scripts/download.ts",
    "data:convert": "node --import tsx ./src/data/scripts/convert.ts",
    "data:refresh": "pnpm data:download && pnpm data:convert",
    "ui-gen": "pnpm exec shadcn add --overwrite badge button-group card collapsible combobox field input-group select separator sheet skeleton spinner --overwrite",
    "ui-diff": "pnpm ui-gen --diff",
    "dev": "portless run next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "clean": "rimraf .next out"
  },
  "dependencies": {
    "@base-ui/react": "1.5.0",
    "@hono/zod-validator": "0.8.0",
    "@hookform/resolvers": "5.4.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "countries-list": "3.3.0",
    "hono": "4.12.23",
    "lucide-react": "1.16.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hook-form": "7.76.1",
    "shadcn": "4.8.0",
    "shiki": "4.1.0",
    "swr": "2.4.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@vercel/config": "0.5.0",
    "babel-plugin-react-compiler": "1.0.0",
    "csv-parse": "6.2.1",
    "oxfmt": "0.51.0",
    "oxlint": "1.66.0",
    "portless": "0.13.0",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.0",
    "tsx": "4.22.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.0.14",
    "vitest": "4.1.7"
  },
  "packageManager": "pnpm@10.33.0"
}
